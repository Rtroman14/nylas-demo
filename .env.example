# Copy to .env and fill in. Never commit .env.

# --- Required for every Nylas call ---
# Nylas Dashboard -> your application -> API Keys.
NYLAS_API_KEY=

# US is the default. EU applications MUST use https://api.eu.nylas.com — an EU
# grant is invisible to the US host and vice versa.
NYLAS_API_URI=https://api.us.nylas.com

# --- Required for the hosted OAuth connect flow ---
# Nylas Dashboard -> your application -> Overview. This is NOT the API key.
NYLAS_CLIENT_ID=

# Must be registered verbatim under Dashboard -> Application -> Callback URIs,
# or Nylas rejects the authorization request.
NYLAS_CALLBACK_URI=http://localhost:3000/oauth/callback

# Which provider the Connect button uses. google | microsoft | imap | yahoo | icloud
# Leave blank to let Nylas show its own provider picker.
NYLAS_AUTH_PROVIDER=google

# --- Webhooks ---
# Generated by Nylas when your endpoint passes the challenge handshake.
# Blank disables signature verification (fine for local dev, never in production).
NYLAS_WEBHOOK_SECRET=

# "true" rejects notifications whose signature does not match instead of just
# labeling them in the log. Ignored while NYLAS_WEBHOOK_SECRET is blank.
REQUIRE_VALID_SIGNATURE=false

# --- Optional ---
PORT=3000

# Skips the connect flow entirely by pinning one mailbox. Useful for scripts.
# The OAuth flow writes the grant to .data/grants.json and takes precedence.
NYLAS_GRANT_ID=
